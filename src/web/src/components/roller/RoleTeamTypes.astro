---
import type { RoleWithTypes } from '../../types/role'
import TeamTypeTag from '../team/TeamTypeTag.astro'

interface Props {
  role: Pick<RoleWithTypes, 'teamTypes'>
}

// The team types the role is relevant for (RO-03), as tags. A role without
// team types is one teams work with, such as linjeleder.
const { teamTypes } = Astro.props.role
---

{
  teamTypes.length ? (
    <div>
      <span class="ds-sr-only">Aktuell for</span>
      <ul>
        {teamTypes.map((type) => (
          <li>
            <TeamTypeTag type={type} rounded />
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <span class="ds-tag" data-color="neutral" data-size="sm">
      Samspiller med team
    </span>
  )
}

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-size-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ds-tag {
    --dsc-tag-border-radius: var(--ds-border-radius-full);
  }
</style>
