---
import type { RoleWithTypes } from '../../types/role'
import { teamTypeHref } from '../../lib/teamTypes'
import Tag from '../Tag.astro'

interface Props {
  role: Pick<RoleWithTypes, 'teamTypes'>
}

// The team types the role is relevant for (RO-03), as tags. A role without
// team types is one teams work with, such as linjeleder.
const { teamTypes } = Astro.props.role
---

{
  teamTypes.length ? (
    <div>
      <span class="ds-sr-only">Aktuell for</span>
      <ul>
        {teamTypes.map((type) => (
          <li>
            <Tag href={teamTypeHref(type.id)}>{type.name}</Tag>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <Tag color="neutral">Samspiller med team</Tag>
  )
}

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-size-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
