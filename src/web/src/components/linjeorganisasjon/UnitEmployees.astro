---
import type { UnitPerson } from '../../types/unit'
import Avatar from '../Avatar.astro'

interface Props {
  employees: UnitPerson[]
}

const { employees } = Astro.props
---

<!-- The people who work in the unit itself, with their title and contact information (LO-02). -->
{
  employees.length ? (
    <ul class="employees">
      {employees.map((person) => (
        <li>
          <Avatar name={person.name} size="md" />
          <div class="details">
            <p class="ds-paragraph name">{person.name}</p>
            {person.title && (
              <p class="ds-paragraph subtle" data-size="sm">
                {person.title}
              </p>
            )}
            <p class="ds-paragraph" data-size="sm">
              <a class="ds-link" href={`mailto:${person.email}`}>
                {person.email}
              </a>
            </p>
            {person.mobile && (
              <p class="ds-paragraph subtle" data-size="sm">
                {person.mobile}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="ds-paragraph">Ingen ansatte er registrert i enheten.</p>
  )
}

<style>
  .employees {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--ds-size-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    align-items: flex-start;
    gap: var(--ds-size-3);
    padding: var(--ds-size-4);
    border: var(--ds-border-width-default) solid var(--ds-color-border-subtle);
    border-radius: var(--ds-border-radius-md);
  }

  .details {
    min-inline-size: 0;
  }

  .details p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .name {
    font-weight: var(--ds-font-weight-semibold);
  }

  .subtle {
    color: var(--ds-color-text-subtle);
  }
</style>
