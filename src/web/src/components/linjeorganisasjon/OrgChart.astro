---
import type { OrgUnit } from '../../types/unit'
import UnitColumn from './UnitColumn.astro'

interface Props {
  /** The directorate, with the units under it. */
  directorate: OrgUnit
}

const { directorate } = Astro.props
const authorities = directorate.children.filter((u) => u.level === 'authority')
const staff = directorate.children.filter((u) => u.level === 'support')
const divisions = directorate.children.filter((u) => u.level !== 'authority' && u.level !== 'support')
---

<!--
  The organisation chart (LO-01), laid out as in the prototype: the director in
  the middle, the supervisory authority (tilsyn) to the left with a dashed line,
  since it is independent, and the staff (stab) to the right. The divisions are
  in a row under, each with its departments and sections. Nested lists, so it
  reads as a tree without the lines.
-->
<div class="chart">
  <div class="top">
    <div class="spine">
      <div class="director">
        <span class="label">Direktør</span>
        <span class="name">{directorate.leader ?? 'Ikke registrert'}</span>
      </div>
    </div>
    {
      authorities.length > 0 && (
        <div class="side authority">
          <ul aria-label="Tilsyn">
            {authorities.map((unit) => (
              <li>
                <UnitColumn unit={unit} />
              </li>
            ))}
          </ul>
          <span class="link" aria-hidden="true" />
        </div>
      )
    }
    {
      staff.length > 0 && (
        <div class="side staff">
          <span class="link" aria-hidden="true" />
          <ul aria-label="Stab">
            {staff.map((unit) => (
              <li>
                <UnitColumn unit={unit} variant="light" />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
  {
    divisions.length > 0 && (
      <ul class="divisions" aria-label="Divisjoner">
        {divisions.map((division) => (
          <li>
            <UnitColumn unit={division} />
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .chart {
    --line-width: calc(2 * var(--ds-border-width-default));
    --line: var(--line-width) solid var(--ds-color-border-subtle);
    /* Where the lines to the sides meet the director's line. */
    --link-top: var(--ds-size-10);
    display: flex;
    flex-direction: column;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Tilsyn, director and stab in three columns, with the director's line
     running down the middle to the divisions. */
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-areas: 'authority spine staff';
  }

  .spine {
    grid-area: spine;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .spine::after {
    content: '';
    flex: 1;
    min-block-size: var(--ds-size-6);
    border-inline-start: var(--line);
  }

  .director {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ds-size-1);
    padding: var(--ds-size-3) var(--ds-size-6);
    border-radius: var(--ds-border-radius-md);
    background: var(--ds-color-accent-base-default);
    color: var(--ds-color-accent-base-contrast-default);
    text-align: center;
  }

  .label {
    font-size: var(--ds-body-sm-font-size);
    font-weight: var(--ds-font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .name {
    font-weight: var(--ds-font-weight-medium);
  }

  .side {
    display: flex;
    align-items: flex-start;
    padding-block: var(--ds-size-6);
  }

  .side ul {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
    inline-size: min(100%, 15rem);
  }

  .authority {
    grid-area: authority;
    justify-content: flex-end;
  }

  .staff {
    grid-area: staff;
  }

  .link {
    flex: 1 0 var(--ds-size-6);
    margin-block-start: calc(var(--link-top) - var(--ds-size-6));
  }

  /* Dashed to the tilsyn, which is independent of the line. */
  .authority .link {
    border-block-start: var(--line-width) dashed var(--ds-color-border-default);
  }

  .staff .link {
    border-block-start: var(--line);
  }

  .divisions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: var(--ds-size-2);
    padding-block-start: var(--ds-size-4);
    border-block-start: var(--line);
  }

  /* On a narrow screen everything is one column under the director, without
     the lines. */
  @media (max-width: 40rem) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'spine' 'authority' 'staff';
      gap: var(--ds-size-6);
    }

    .spine::after,
    .link {
      display: none;
    }

    .side {
      padding-block: 0;
    }

    .side ul {
      inline-size: 100%;
    }

    .divisions {
      gap: var(--ds-size-6);
      margin-block-start: var(--ds-size-6);
      padding-block-start: 0;
      border-block-start: none;
    }
  }
</style>
