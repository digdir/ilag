---
import type { OrgUnit } from '../../types/unit'

interface Props {
  /** A division, or a staff unit or supervisory authority beside the director. */
  unit: OrgUnit
  /** Light for the staff, like the prototype; dark for the rest. */
  variant?: 'dark' | 'light'
  /** The units under it as small tiles, two to a row, as for the tilsyn in the prototype. */
  tiles?: boolean
}

const { unit, variant = 'dark', tiles = false } = Astro.props
// Each unit links to its page (LO-05).
const href = (u: OrgUnit) => `/organisering/linjeorganisasjon/${u.id}`
---

<!-- A unit under the director with its departments, and their sections under them (LO-01). -->
<div class="unit">
  <div class="head" data-variant={variant}>
    <span class="top">
      {unit.code && <span class="code">{unit.code}</span>}
      {
        /* Only the number, as in the prototype; «ansatte» for screen readers.
           Nothing when nobody is registered in the unit yet. */
        unit.size > 0 && (
          <span class="size" title="Antall ansatte">
            {unit.size}
            <span class="ds-sr-only">{unit.size === 1 ? ' ansatt' : ' ansatte'}</span>
          </span>
        )
      }
    </span>
    <a class="name" href={href(unit)}>{unit.name}</a>
    <span class="leader">{unit.leader ?? 'Leder ikke registrert'}</span>
  </div>
  {
    unit.children.length > 0 && (
      <ul class:list={['departments', { tiles }]} aria-label={`Enheter i ${unit.name}`}>
        {unit.children.map((department) => (
          <li>
            <a class="department" href={href(department)}>
              {department.name}
            </a>
            {department.children.length > 0 && (
              <ul class="sections" aria-label={`Enheter i ${department.name}`}>
                {department.children.map((section) => (
                  <li>
                    <a class="section" href={href(section)}>
                      {section.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  /* Sizes from the prototype, with the chart at data-size="sm": body-xs is
     12px, body-sm 14px. */
  .unit {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-1);
    padding: var(--ds-size-3);
    border-radius: var(--ds-border-radius-md);
    background: var(--ds-color-neutral-base-default);
    color: var(--ds-color-neutral-base-contrast-default);
  }

  .head[data-variant='light'] {
    border: var(--ds-border-width-default) solid var(--ds-color-neutral-border-subtle);
    background: var(--ds-color-neutral-background-default);
    color: var(--ds-color-neutral-text-default);
  }

  .top,
  .leader {
    font-size: var(--ds-body-xs-font-size);
  }

  /* Softer than the name, as in the prototype. */
  .head[data-variant='dark'] :is(.top, .leader) {
    opacity: 0.8;
  }

  .head[data-variant='light'] :is(.top, .leader) {
    color: var(--ds-color-neutral-text-subtle);
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--ds-size-2);
  }

  .code {
    font-weight: var(--ds-font-weight-semibold);
    letter-spacing: 0.08em;
  }

  .size {
    margin-inline-start: auto;
    font-variant-numeric: tabular-nums;
  }

  /* The boxes are the links; underlined on hover, like a card. */
  a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration: underline;
  }

  a:focus-visible {
    outline: var(--ds-border-width-focus) solid var(--ds-color-focus-outer);
    outline-offset: 2px;
  }

  .name {
    font-size: var(--ds-body-sm-font-size);
    font-weight: var(--ds-font-weight-semibold);
    line-height: 1.3;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .departments {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  .department {
    display: block;
    padding: var(--ds-size-2) var(--ds-size-3);
    border: var(--ds-border-width-default) solid var(--ds-color-neutral-border-subtle);
    border-radius: var(--ds-border-radius-md);
    background: var(--ds-color-neutral-background-default);
    color: var(--ds-color-neutral-text-default);
    font-size: var(--ds-body-sm-font-size);
    font-weight: var(--ds-font-weight-medium);
    line-height: 1.4;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-1);
    margin-block-start: var(--ds-size-2);
    padding-inline-start: var(--ds-size-2);
    border-inline-start: calc(2 * var(--ds-border-width-default)) solid var(--ds-color-neutral-border-subtle);
  }

  .section,
  .tiles .department {
    display: block;
    padding: var(--ds-size-1) var(--ds-size-2);
    border: none;
    border-radius: var(--ds-border-radius-md);
    background: var(--ds-color-neutral-background-tinted);
    color: var(--ds-color-neutral-text-subtle);
    font-size: var(--ds-body-xs-font-size);
    font-weight: normal;
    line-height: 1.5;
  }

  /* The tilsyn's units: two small tiles to a row, the names centred. */
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ds-size-1);
  }

  .tiles .department {
    padding-block: var(--ds-size-2);
    font-size: var(--ds-body-sm-font-size);
    text-align: center;
  }
</style>
