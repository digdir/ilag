---
import FeedbackForm from './feedback/FeedbackForm.astro'
import { FEEDBACK_SENT, feedbackOwner } from '../lib/feedback'

interface Props {
  /** Without a logged-in user (the login page) there is nothing to report from. */
  signedIn: boolean
  url: URL
  /** The page's title, so the report says what it is about. */
  title: string
}

const { signedIn, url, title } = Astro.props
const page = url.pathname
const pageTitle = title.replace(/ — ilag$/, '')
const canReport = signedIn && page !== '/meld-fra'
const sent = url.search.slice(1) === FEEDBACK_SENT
---

<footer>
  {
    sent && (
      <div class="inner">
        <div class="ds-alert" data-color="success" role="status">
          <p class="ds-paragraph">Takk! Tilbakemeldingen er sendt til {feedbackOwner(page).label}.</p>
        </div>
      </div>
    )
  }
  <div class="inner links">
    <span class="ds-paragraph" data-size="sm">Forvaltes av Virksomhetsstyring og utvikling (VSU)</span>
    {
      canReport && (
        <button class="ds-link" data-size="sm" type="button" command="show-modal" commandfor="meld-fra">
          Meld fra om feil
        </button>
      )
    }
  </div>
  {
    canReport && (
      <dialog class="ds-dialog" id="meld-fra" data-modal="true" closedby="any">
        <button
          class="ds-button"
          data-icon="true"
          data-variant="tertiary"
          data-color="neutral"
          type="button"
          aria-label="Lukk dialogvindu"
          command="close"
          commandfor="meld-fra"
        />
        <h2 class="ds-heading" data-size="md">
          Meld fra om feil
        </h2>
        <FeedbackForm page={page} pageTitle={pageTitle} dialogId="meld-fra" />
      </dialog>
    )
  }
</footer>

<style>
  footer {
    margin-block-start: var(--ds-size-12);
    border-block-start: 1px solid var(--ds-color-neutral-border-subtle);
    background: var(--ds-color-neutral-background-tinted);
  }

  .inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: var(--ds-size-6) var(--ds-size-4) 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-size-4) var(--ds-size-8);
    align-items: baseline;
    padding-block-end: var(--ds-size-6);
  }

  /* Room for the whole form on a laptop screen; Designsystemet's default is 80vh. */
  dialog {
    --dsc-dialog-max-height: 90dvh;
  }

  dialog h2 {
    margin-block-end: var(--ds-size-4);
  }
</style>
