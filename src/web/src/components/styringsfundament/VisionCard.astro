---

interface Props {
  vision: string
}

// The vision, large on a dark card.
const { vision } = Astro.props
---

<section class="ds-card" data-color-scheme="dark" aria-labelledby="visjon">
  <h2 class="ds-heading" data-size="2xs" id="visjon">Vår visjon</h2>
  <p class="ds-heading" data-size="lg">{vision}</p>
</section>

<style>
  section {
    background: var(--ds-color-neutral-background-default);
    color: var(--ds-color-neutral-text-default);
    padding: var(--ds-size-8);
  }
</style>
