---
interface Props {
  columns: 2 | 3
}

// Cards side by side, such as the goals or the values. Closed, they are all
// the same size; opening one grows only its own row.
const { columns } = Astro.props
---

<div class="cards" style={`--columns: ${columns}`}>
  <slot />
</div>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--ds-size-4);
  }

  .cards:has(details[open]) {
    grid-auto-rows: auto;
  }

  /* In one column, equal heights only add empty space. */
  @media (width < 40rem) {
    .cards {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
  }
</style>
