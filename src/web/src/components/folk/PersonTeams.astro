---
import type { PersonDetail } from '../../types/person'

interface Props {
  teams: PersonDetail['teams']
}

const { teams } = Astro.props
---

<!-- The person's active teams with their roles there (FO-02). No allocation (AL-04). -->
{
  teams.length ? (
    <ul class="teams">
      {teams.map((team) => (
        <li>
          <a class="ds-link" href={`/organisering/team/${team.id}`}>
            {team.name}
          </a>
          {team.roles.length > 0 && (
            <span class="ds-paragraph roles" data-size="sm">
              {team.roles.join(', ')}
            </span>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <p class="ds-paragraph none">Ikke med i noen team.</p>
  )
}

<style>
  .teams {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ds-size-1) var(--ds-size-4);
    padding: var(--ds-size-3) 0;
  }

  li + li {
    border-top: var(--ds-border-width-default) solid var(--ds-color-border-subtle);
  }

  .roles,
  .none {
    margin: 0;
    color: var(--ds-color-text-subtle);
  }
</style>
