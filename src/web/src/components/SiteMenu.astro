---
import { hasSubMenu, isWithin, mainMenu } from '../lib/navigation'
import MainMenu from './MainMenu.astro'
import SubMenu from './SubMenu.astro'

interface Props {
  pathname: string
}

const { pathname } = Astro.props
const groups = mainMenu().filter(hasSubMenu)
---

{/* The main menu, with a submenu row for each group that has one. The current group's row shows. */}
<div data-site-menu>
  <MainMenu pathname={pathname} />
  {groups.map((group) => <SubMenu group={group} pathname={pathname} hidden={!isWithin(pathname, group.path)} />)}
</div>

<script>
  // A main menu item with a submenu shows that submenu instead of going to a
  // page. Clicking it again goes back to the current group's submenu, if any.
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')

  // Grows or shrinks a row's height, so the header extends smoothly; the
  // links themselves don't move or fade. Resolves when done, rejects if cancelled.
  const resize = (row: HTMLElement, opening: boolean) => {
    if (reducedMotion.matches) return Promise.resolve()
    const height = `${row.scrollHeight}px`
    return row.animate(
      { height: opening ? ['0px', height] : [height, '0px'], overflow: ['hidden', 'hidden'] },
      { duration: 200, easing: 'ease-out' },
    ).finished
  }

  for (const menu of document.querySelectorAll<HTMLElement>('[data-site-menu]')) {
    const rows = [...menu.querySelectorAll<HTMLElement>(':scope > nav[id]')]
    const current = rows.find((row) => !row.hidden)
    const buttons: HTMLButtonElement[] = []

    const show = (id: string | undefined) => {
      for (const button of buttons) {
        button.setAttribute('aria-expanded', String(button.getAttribute('aria-controls') === id))
      }
      const before = rows.find((row) => !row.hidden)
      const after = rows.find((row) => row.id === id)
      for (const row of rows) for (const animation of row.getAnimations()) animation.cancel()
      if (before === after) return

      if (before && after) {
        // Switching between two sections: the header keeps its height.
        before.hidden = true
        after.hidden = false
      } else if (after) {
        after.hidden = false
        resize(after, true).catch(() => {})
      } else if (before) {
        resize(before, false).then(
          () => (before.hidden = true),
          () => {}, // Cancelled by another click, which decides what shows.
        )
      }
    }

    for (const link of menu.querySelectorAll<HTMLAnchorElement>('a[data-submenu]')) {
      const id = link.dataset.submenu!
      const button = document.createElement('button')
      button.type = 'button'
      button.className = link.className
      button.textContent = link.textContent
      button.setAttribute('aria-controls', id)
      if (link.hasAttribute('data-current')) button.dataset.current = ''
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true'
        show(open ? current?.id : id)
      })
      link.replaceWith(button)
      buttons.push(button)
    }

    show(current?.id)
  }
</script>
