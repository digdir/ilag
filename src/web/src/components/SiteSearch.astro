---
import { MIN_QUERY_LENGTH } from '../lib/cms/search'
import SearchField from './SearchField.astro'
---

<!--
  The search across ilag in the header (FS-01): type part of the name of a
  team, unit, person, role or tool, and pick it to go to its page. Built on
  SearchField, a Designsystemet Suggestion, which handles the keyboard and the
  screen reader texts; the script below fills its list from /sok.json, since the CMS
  does the matching. Without JavaScript the field does nothing.
-->
<SearchField
  class="site-search"
  id="site-search"
  label="Søk i ilag"
  hideLabel
  placeholder="Søk etter team, enheter, folk …"
  size="sm"
  data-site-search
  data-min={MIN_QUERY_LENGTH}
>
  <u-datalist data-nofilter></u-datalist>
</SearchField>

<script>
  import type { SearchHit } from '../types/search'

  // A short pause after the last key, so a fast typist sends one search.
  const DELAY_MS = 200

  for (const box of document.querySelectorAll<HTMLElement>('[data-site-search]')) {
    const input = box.querySelector<HTMLInputElement>('input')!
    const list = box.querySelector<HTMLElement>('u-datalist')!
    // Suggestion shows this option when there are no hits. It is only in the
    // list once something has been typed, so an empty field opens no list.
    const empty = document.createElement('u-option')
    empty.toggleAttribute('data-empty', true)
    const min = Number(box.dataset.min)
    let timer: ReturnType<typeof setTimeout> | undefined
    let pending: AbortController | undefined

    const option = (hit: SearchHit) => {
      const el = document.createElement('u-option')
      el.setAttribute('value', hit.url)
      el.setAttribute('label', hit.title)
      const title = document.createElement('span')
      title.className = 'title'
      title.textContent = hit.title
      const meta = document.createElement('span')
      meta.className = 'meta'
      meta.textContent = [hit.kindLabel, hit.subtitle].filter(Boolean).join(' · ')
      el.append(title, meta)
      return el
    }

    const show = (hits: SearchHit[], emptyText = 'Ingen treff') => {
      empty.textContent = emptyText
      list.replaceChildren(...hits.map(option), empty)
    }

    const run = async (query: string) => {
      pending?.abort()
      pending = new AbortController()
      try {
        const response = await fetch(`/sok.json?q=${encodeURIComponent(query)}`, { signal: pending.signal })
        if (!response.ok) throw new Error(String(response.status))
        show(await response.json())
      } catch (err) {
        if ((err as Error).name !== 'AbortError') show([], 'Søket virker ikke akkurat nå')
      }
    }

    input.addEventListener('input', (event) => {
      clearTimeout(timer)
      const query = input.value.trim()
      // Picking a hit fills in its name, which needs no new search. The clear
      // button empties the field the same way, and that does close the list.
      if (!(event instanceof InputEvent) || (!event.isTrusted && query)) return
      if (query.length < min) {
        pending?.abort()
        if (query) show([], `Skriv minst ${min} tegn`)
        else list.replaceChildren()
        return
      }
      show([], 'Søker …')
      timer = setTimeout(() => run(query), DELAY_MS)
    })

    // A hit's value is its page.
    box.addEventListener('comboboxafterselect', (event) => {
      const chosen = (event as CustomEvent<HTMLDataElement>).detail
      if (chosen?.isConnected && chosen.value.startsWith('/')) window.location.assign(chosen.value)
    })
  }
</script>

<style>
  :global(.site-search) {
    flex: 1 1 16rem;
    max-width: 28rem;
  }

  /*
   * Designsystemet makes the list as wide as the field and as tall as the room
   * below it, the height set on the element itself. Long enough for about six
   * hits here; the rest scroll.
   */
  :global(.site-search u-datalist) {
    max-height: min(24rem, 60vh) !important;
  }

  /* Nothing typed yet: no list, not an empty box under the field. */
  :global(.site-search u-datalist:empty) {
    display: none !important;
  }

  :global(.site-search u-option) {
    display: grid;
    gap: var(--ds-size-1);
  }

  :global(.site-search u-option .meta) {
    color: var(--ds-color-neutral-text-subtle);
    font-size: 0.875rem;
  }
</style>
