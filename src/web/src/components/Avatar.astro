---
interface Props {
  name: string
  size?: 'sm' | 'md' | 'lg'
  /** Without it, the colour of the nearest parent with data-color, as in Folk. */
  color?: 'accent' | 'neutral'
}

const { name, size = 'sm', color } = Astro.props

// First and last initial: «Emma Kristiansen» → «EK».
const initials = name
  .split(' ')
  .filter(Boolean)
  .map((part) => part[0])
  .filter((_, i, all) => i === 0 || i === all.length - 1)
  .join('')
---

<span class="ds-avatar" data-size={size} data-color={color} aria-hidden="true">{initials}</span>
