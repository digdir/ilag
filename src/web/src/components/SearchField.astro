---
import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'div'>, 'id'> {
  /** The input's id. */
  id: string
  label: string
  /** Hide the label for sight, as in the header, where the placeholder says what the field is for. */
  hideLabel?: boolean
  placeholder?: string
  size?: 'sm' | 'md' | 'lg'
}

const { id, label, hideLabel = false, placeholder, size, class: className, ...rest } = Astro.props
---

<!--
  A search field as Designsystemet draws it: a magnifying glass at the start
  and a button to empty it at the end, with ilag's own focus (below). Every
  search field in ilag is one of these, so they look and behave the same.

  Designsystemet's Search is deprecated; its replacement is a Suggestion around
  an input of type search, which also shows, hides and handles the clear
  button. Emptying the field sends an input event. A list of hits, a
  <u-datalist>, goes in the default slot; without one it is a plain field.
-->
<ds-field class:list={['ds-field', className]} data-size={size}>
  <label class:list={['ds-label', { 'ds-sr-only': hideLabel }]} for={id}>{label}</label>
  <ds-suggestion class="ds-suggestion" {...rest}>
    <input class="ds-input" id={id} type="search" placeholder={placeholder} autocomplete="off" />
    <button type="reset" hidden></button>
    <slot />
  </ds-suggestion>
</ds-field>

<style>
  /*
   * A quieter focus than Designsystemet's ring around the field: its border
   * in the accent colour, a little thicker. Still clearly visible (WCAG 2.4.7).
   */
  .ds-input:focus-visible {
    box-shadow: none;
    outline: 2px solid var(--ds-color-accent-border-strong);
    outline-offset: -1px;
  }
</style>
