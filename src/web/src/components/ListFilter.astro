---
interface Chip {
  value: string
  label: string
}

/** A row of chips to filter by, with «Alle» first. */
interface ChipRow {
  /** Names the row. Items carry their values for it in `data-filter-<key>`. */
  key: string
  legend: string
  options: Chip[]
  /**
   * With `countSuffix`, a chosen chip is named in the count after it, in lowercase, such as
   * `'av typen'` for «2 team av typen produktteam».
   */
  countSuffix?: string
}

interface Props {
  /** The id of the list to filter. Its items to filter carry `data-search`. */
  list: string
  /** The id of the message to show when nothing matches, if there is one. */
  empty?: string
  label: string
  placeholder: string
  /** How many items there are before filtering. */
  count: number
  /** The word for what is counted, such as `{ one: 'rolle', other: 'roller' }`. */
  noun: { one: string; other: string }
  /** Optional rows of chips to filter by. An item must match the chosen chip in every row. */
  chips?: ChipRow[]
}

const { list, empty, label, placeholder, count, noun, chips = [] } = Astro.props
const countLabel = (n: number) => `${n} ${n === 1 ? noun.one : noun.other}`
---

<!--
  Search and filter a list the page has already rendered. The script hides the
  items in the list that don't match: an item shows when every word searched
  for is in its data-search and, in each row of chips where a chip is chosen,
  the chip's value is one of the space-separated values in the item's
  data-filter-<key>. Without JavaScript, all show.
-->
<div
  class="list-filter"
  data-list-filter
  data-list={list}
  data-empty={empty}
  data-one={noun.one}
  data-other={noun.other}
>
  <ds-field class="ds-field">
    <label class="ds-label" for={`${list}-search`}>{label}</label>
    <input class="ds-input" id={`${list}-search`} type="search" placeholder={placeholder} />
  </ds-field>
  {
    chips.map((row) => (
      <fieldset class="ds-fieldset" data-chip-row={row.key} data-count-suffix={row.countSuffix}>
        {/* The legend names the chips for screen readers; the same word shows,
            greyed, on the same line before them, where a legend can't be placed. */}
        <legend class="ds-sr-only">{row.legend}</legend>
        <div class="chips" data-size="sm">
          <span class="chips-label" aria-hidden="true">
            {row.legend}
          </span>
          {[{ value: '', label: 'Alle' }, ...row.options].map((chip) => (
            <label class="ds-chip">
              <input
                class="ds-input"
                type="radio"
                name={`${list}-${row.key}`}
                value={chip.value}
                checked={chip.value === ''}
              />
              {chip.label}
            </label>
          ))}
        </div>
      </fieldset>
    ))
  }
  <p
    class="ds-paragraph count"
    data-size="sm"
    data-color="neutral"
    aria-live="polite"
    data-filter-count
  >
    {countLabel(count)}
  </p>
</div>

<script>
  for (const filter of document.querySelectorAll<HTMLElement>('[data-list-filter]')) {
    const { list, empty, one, other } = filter.dataset
    const search = filter.querySelector<HTMLInputElement>('input[type=search]')!
    const count = filter.querySelector<HTMLElement>('[data-filter-count]')!
    const message = empty ? document.getElementById(empty) : null
    const items = [...document.getElementById(list!)!.querySelectorAll<HTMLElement>('[data-search]')]

    const rows = [...filter.querySelectorAll<HTMLElement>('[data-chip-row]')]

    filter.addEventListener('input', () => {
      const words = search.value.trim().toLowerCase().split(/\s+/)
      const chosen = rows.flatMap((row) => {
        const input = row.querySelector<HTMLInputElement>('input[type=radio]:checked')
        return input?.value ? [{ row, input }] : []
      })
      let shown = 0
      for (const item of items) {
        const matches = words.every((word) => item.dataset.search!.includes(word))
        const inChips = chosen.every(({ row, input }) =>
          (item.getAttribute(`data-filter-${row.dataset.chipRow}`) ?? '').split(' ').includes(input.value),
        )
        item.hidden = !(matches && inChips)
        if (!item.hidden) shown++
      }
      const chipNames = chosen
        .filter(({ row }) => row.dataset.countSuffix)
        .map(({ row, input }) => ` ${row.dataset.countSuffix} ${input.parentElement!.textContent!.trim().toLowerCase()}`)
      count.textContent = `${shown} ${shown === 1 ? one : other}${chipNames.join('')}`
      if (message) message.hidden = shown > 0
    })
  }
</script>

<style>
  .list-filter {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
  }

  ds-field {
    max-width: 28rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ds-size-2);
  }

  .chips-label {
    margin-inline-end: var(--ds-size-2);
    color: var(--ds-color-neutral-text-subtle);
    font-size: var(--ds-body-sm-font-size);
  }

  /* Chips without the radio circle: the chosen one still has its colour. The
     input stays for the keyboard and screen readers, just out of sight. */
  .ds-chip:has(input) {
    padding-inline-start: var(--dsc-chip-padding-inline);
  }

  .ds-chip > input {
    opacity: 0;
  }

  .count {
    margin: 0;
    color: var(--ds-color-text-subtle);
  }
</style>
