---
import type { CardsBox } from '@ilag/shared'

import Markdown from '../Markdown.astro'
import Prose from '../Prose.astro'
import BoxHeading from './BoxHeading.astro'

interface Props {
  box: CardsBox
  id: string
}

// Cards side by side, such as the goals or the values: a title, a short text
// and more behind a toggle. «Ulike farger» tints them by position, as the
// goals in the prototype; otherwise they are grey.
const { box, id } = Astro.props
const tints = box.colors === 'varied' ? ['accent', 'warning', 'danger', 'neutral'] : ['neutral']
// Three across when that fills every row, such as three values; otherwise two, such as four goals.
const columns = (box.cards?.length ?? 0) % 3 === 0 ? 3 : 2
---

<section aria-labelledby={id}>
  <BoxHeading id={id}>{box.heading}</BoxHeading>
  <div class="cards" style={`--columns: ${columns}`}>
    {
      box.cards?.map((card, i) => (
        <article class="ds-card" data-color={tints[i % tints.length]} data-variant="tinted">
          <div class="ds-card__block">
            <h3 class="ds-heading" data-size="xs">{card.title}</h3>
            <Prose text={card.text} />
          </div>
          {card.details && (
            <details class="ds-details">
              <summary>{box.detailsLabel || 'Les mer'}</summary>
              <div>
                <Markdown text={card.details} />
              </div>
            </details>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: var(--ds-size-4);
    align-items: start;
  }

  @media (width < 40rem) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
