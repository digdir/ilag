---
interface Props {
  /** Unique on the page, for the box's aria-labelledby. */
  id: string
}

// The small heading over a box, such as «Våre verdiar».
const { id } = Astro.props
---

<h2 class="label" id={id}><slot /></h2>

<style>
  .label {
    margin: 0;
    font-size: var(--ds-font-size-2);
    font-weight: var(--ds-font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ds-color-neutral-text-subtle);
  }
</style>
