---
import type { TextWithFilesBox } from '@ilag/shared'

import Markdown from '../Markdown.astro'
import FileLinks from './FileLinks.astro'

interface Props {
  box: TextWithFilesBox
  id: string
}

// A heading, text and documents, such as the Virksomhetsplan.
const { box, id } = Astro.props
---

<section class="ds-card" aria-labelledby={id}>
  <h2 class="ds-heading" data-size="xs" id={id}>{box.heading}</h2>
  <Markdown text={box.text} />
  <FileLinks files={box.files} />
</section>
