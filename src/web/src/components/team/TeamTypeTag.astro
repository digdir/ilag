---
import type { TeamType } from '@ilag/shared'

interface Props {
  type: Pick<TeamType, 'name'>
  /** Fully rounded ends, as on the role pages. */
  rounded?: boolean
}

const { type, rounded = false } = Astro.props
---

<span class:list={['ds-tag', { rounded }]} data-color="info" data-size="sm">{type.name}</span>

<style>
  .rounded {
    --dsc-tag-border-radius: var(--ds-border-radius-full);
  }
</style>
