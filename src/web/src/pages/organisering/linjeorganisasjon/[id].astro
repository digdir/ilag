---
import Prose from '../../../components/Prose.astro'
import Tag from '../../../components/Tag.astro'
import SubUnits from '../../../components/linjeorganisasjon/SubUnits.astro'
import UnitEmployees from '../../../components/linjeorganisasjon/UnitEmployees.astro'
import UnitLeader from '../../../components/linjeorganisasjon/UnitLeader.astro'
import Layout from '../../../layouts/Layout.astro'
import { getUnit, levelLabels } from '../../../lib/cms/units'

const cookie = Astro.request.headers.get('cookie')
const unit = await getUnit(Astro.params.id!, cookie)
if (!unit) Astro.response.status = 404

// The units above it, between Linjeorganisasjon and the unit in the breadcrumbs.
const trail = unit?.ancestors.map(({ id, name }) => ({
  label: name,
  href: `/organisering/linjeorganisasjon/${id}`,
}))

const count = (n: number) => (n === 1 ? '1 ansatt' : `${n} ansatte`)
---

<!--
  The unit page (LO-02): the leader with contact information, the people who
  work in the unit and the units under it. Mandate and OKR come later.
-->
<Layout
  title={unit ? `${unit.name} — ilag` : 'Fant ikke enheten — ilag'}
  wide
  current={unit?.name}
  trail={trail}
>
  <div class="page">
    {
      unit ? (
        <>
          <header data-color="neutral">
            <p class="ds-paragraph meta" data-size="sm">
              {[unit.code, levelLabels[unit.level]].filter(Boolean).join(' · ')}
            </p>
            <h1 class="ds-heading" data-size="lg">
              {unit.name}
            </h1>
            <Prose text={unit.description} />
            {unit.advisesAllOfDigdir && (
              <Tag>Bistår og rådgir hele Digdir</Tag>
            )}
          </header>
          <section aria-labelledby="leder" data-color="neutral">
            <h2 class="ds-heading" data-size="sm" id="leder">
              Leder
            </h2>
            <UnitLeader leader={unit.leader} />
          </section>
          <section aria-labelledby="ansatte" data-color="neutral">
            <div class="section-head">
              <h2 class="ds-heading" data-size="sm" id="ansatte">
                Ansatte
              </h2>
              <span class="ds-paragraph meta" data-size="sm">
                {count(unit.employees.length)}
              </span>
            </div>
            <UnitEmployees employees={unit.employees} />
          </section>
          {unit.children.length > 0 && (
            <section aria-labelledby="enheter-under" data-color="neutral">
              <h2 class="ds-heading" data-size="sm" id="enheter-under">
                Enheter under
              </h2>
              <SubUnits units={unit.children} />
            </section>
          )}
        </>
      ) : (
        <>
          <h1 class="ds-heading" data-size="lg">Fant ikke enheten</h1>
          <p class="ds-paragraph">
            Enheten finnes ikke, er lagt ned, eller du har ikke tilgang til den.
          </p>
        </>
      )
    }
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-8);
  }

  header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ds-size-2);
    max-width: 48rem;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ds-size-4);
  }

  .meta {
    margin: 0;
    color: var(--ds-color-text-subtle);
  }
</style>
