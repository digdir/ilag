---
import Prose from '../../../components/Prose.astro'
import RoleTeamTypes from '../../../components/roller/RoleTeamTypes.astro'
import Layout from '../../../layouts/Layout.astro'
import { getRole } from '../../../lib/cms/roles'
import { ramo } from '../../../lib/roles'

const cookie = Astro.request.headers.get('cookie')
const role = await getRole(Astro.params.id!, cookie)
if (!role) Astro.response.status = 404
---

<Layout title={role ? `${role.name} — ilag` : 'Fant ikke rollen — ilag'} wide current={role?.name}>
  <div class="page">
    {
      role ? (
        <>
          <header>
            <h1 class="ds-heading" data-size="lg">
              {role.name}
            </h1>
            <RoleTeamTypes role={role} />
          </header>
          {ramo(role).length ? (
            <div class="sections">
              {ramo(role).map((field) => (
                <section class="ds-card" data-color="neutral">
                  <h2 class="ds-label" data-size="xs">
                    {field.label}
                  </h2>
                  <Prose text={field.value} />
                </section>
              ))}
            </div>
          ) : (
            <p class="ds-paragraph">Rollen er ikke beskrevet ennå.</p>
          )}
        </>
      ) : (
        <>
          <h1 class="ds-heading" data-size="lg">Fant ikke rollen</h1>
          <p class="ds-paragraph">Rollen finnes ikke, eller du har ikke tilgang til den.</p>
        </>
      )
    }
  </div>
</Layout>

<style>
  /* As on the team type and tool pages: the header on the page, each part of
     RAMO below in a card, two side by side where there is room. */
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-8);
  }

  header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ds-size-3);
    max-width: 48rem;
  }

  .sections {
    display: grid;
    /* At least 40% wide, so never more than two in a row (2×2 for all four),
       and one under the other where two don't fit. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, max(22rem, 40%)), 1fr));
    gap: var(--ds-size-6);
  }

  /* Designsystemet's card isn't a flex container, so it is made one here for
     even space between the heading and the text. */
  .ds-card {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  /* The same blue capitals as the RAMO labels in the role list, a little
     larger here, where each part has a card of its own. */
  h2 {
    margin: 0;
    color: var(--ds-color-accent-text-subtle);
    font-size: var(--ds-font-size-3);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
