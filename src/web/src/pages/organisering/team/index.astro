---
import ListFilter from '../../../components/ListFilter.astro'
import TeamCard from '../../../components/team/TeamCard.astro'
import Layout from '../../../layouts/Layout.astro'
import { getTeams } from '../../../lib/cms/teams'
import { getTeamTypes } from '../../../lib/cms/teamTypes'

const cookie = Astro.request.headers.get('cookie')
const [teams, types] = await Promise.all([getTeams(cookie), getTeamTypes(cookie)])

// Search by name and filter by type (TO-05), like the prototype's
// «2 team av typen produktteam».
const chips = [
  {
    key: 'type',
    legend: 'Teamtype',
    options: types.map((type) => ({ value: String(type.id), label: type.name })),
    countSuffix: 'av typen',
  },
]
---

<Layout title="Teamoversikt — ilag" wide>
  <div class="page">
    <header>
      <h1 class="ds-heading" data-size="lg">Teamoversikt</h1>
      <p class="ds-paragraph">
        Alle team og grupperinger i Digdir, hva de leverer og hvorfor de finnes.
      </p>
    </header>
    {
      teams.length ? (
        <>
          <ListFilter
            list="team"
            empty="team-tom"
            label="Søk i team"
            placeholder="Søk etter teamnavn"
            count={teams.length}
            noun={{ one: 'team', other: 'team' }}
            chips={chips}
          />
          <ul class="teams" id="team">
            {teams.map((team) => (
              <li data-search={team.name.toLowerCase()} data-filter-type={team.teamType?.id}>
                <TeamCard team={team} />
              </li>
            ))}
          </ul>
          <p class="ds-paragraph empty" id="team-tom" hidden>
            Ingen team passer søket. Prøv et annet ord eller fjern filteret.
          </p>
        </>
      ) : (
        <p class="ds-paragraph">Ingen team er registrert ennå.</p>
      )
    }
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-6);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-3);
  }

  .teams {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: var(--ds-size-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .teams > li {
    display: grid;
  }

  .teams > li[hidden] {
    display: none;
  }

  .empty {
    padding: var(--ds-size-8);
    border: var(--ds-border-width-default) dashed var(--ds-color-border-subtle);
    border-radius: var(--ds-border-radius-md);
    text-align: center;
  }

  .empty[hidden] {
    display: none;
  }
</style>
