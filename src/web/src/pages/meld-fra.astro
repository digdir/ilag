---
import { PayloadSDKError } from '@ilag/shared'

import Layout from '../layouts/Layout.astro'
import { sendFeedback } from '../lib/cms/feedback'
import { FEEDBACK_CATEGORIES, feedbackOwner } from '../lib/feedback'
import { sameSiteURL } from '../lib/paths'

// Report an error or gap on the page the visitor came from (TB-01). The CMS
// decides who may read it (TB-02) and whether the reporter is stored (TB-05).
const params = Astro.url.searchParams
const page = sameSiteURL(params.get('side'), Astro.url)?.pathname ?? '/'
const pageTitle = params.get('tittel')?.replace(/ — ilag$/, '') || page
const owner = feedbackOwner(page)
const sent = params.has('sendt')

// What was typed, kept when sending fails so nothing has to be written again.
let error: string | null = null
let category = FEEDBACK_CATEGORIES[0]!.value
let text = ''
let contactMe = false
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const chosen = FEEDBACK_CATEGORIES.find((c) => c.value === form.get('category'))?.value
  text = String(form.get('text') ?? '').trim()
  contactMe = form.get('contactMe') === 'on'
  if (chosen) category = chosen
  if (!chosen || !text) {
    Astro.response.status = 400
    error = 'Velg hva det gjelder, og beskriv hva som er feil.'
  } else {
    try {
      const { team, unit } = owner
      await sendFeedback(
        { category, text, page, contactMe, team, unit },
        Astro.request.headers.get('cookie'),
      )
      const back = new URLSearchParams({ side: page, tittel: pageTitle, sendt: '' })
      return Astro.redirect(`/meld-fra?${back}`, 303)
    } catch (e) {
      if (!(e instanceof PayloadSDKError)) throw e
      Astro.response.status = e.status >= 500 ? 502 : 400
      error = 'Tilbakemeldingen ble ikke sendt. Prøv igjen om litt.'
    }
  }
}
---

<Layout title="Meld fra om feil — ilag">
  <h1 class="ds-heading" data-size="xl">Meld fra om feil</h1>
  {
    sent ? (
      <div class="ds-alert" data-color="success" role="status">
        <p class="ds-paragraph">Takk! Tilbakemeldingen er sendt til {owner.label}.</p>
      </div>
      <p class="ds-paragraph">
        <a class="ds-link" href={page}>Tilbake til {pageTitle}</a>
      </p>
    ) : (
      <>
        <p class="ds-paragraph">
          Gjelder: <strong>{pageTitle}</strong>
          <br />
          Går til: {owner.label}
        </p>
        {error && (
          <div class="ds-alert" data-color="danger" role="alert">
            <p class="ds-paragraph">{error}</p>
          </div>
        )}
        <form method="post">
          <fieldset class="ds-fieldset">
            <legend class="ds-label">Hva gjelder det?</legend>
            {FEEDBACK_CATEGORIES.map(({ value, label }) => (
              <ds-field class="ds-field">
                <input class="ds-input" type="radio" name="category" value={value} checked={value === category} required />
                <label class="ds-label" data-weight="regular">
                  {label}
                </label>
              </ds-field>
            ))}
          </fieldset>
          <ds-field class="ds-field">
            <label class="ds-label">Beskriv kort hva som er feil</label>
            <textarea
              class="ds-input"
              name="text"
              rows="5"
              maxlength="5000"
              placeholder="Hva er feil, og hva burde det stå?"
              required>{text}</textarea>
          </ds-field>
          <ds-field class="ds-field">
            <input class="ds-input" type="checkbox" name="contactMe" checked={contactMe} />
            <label class="ds-label" data-weight="regular">Jeg kan kontaktes om tilbakemeldingen</label>
            <div data-field="description">
              Da lagres navnet ditt sammen med tilbakemeldingen, og du kan se den igjen. Ellers sendes den anonymt.
            </div>
          </ds-field>
          <div class="buttons">
            <button class="ds-button" type="submit">Send tilbakemelding</button>
            <a class="ds-button" data-variant="secondary" href={page}>Avbryt</a>
          </div>
        </form>
      </>
    )
  }
</Layout>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-6);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-size-3);
  }
</style>
