---
import Prose from '../../../components/Prose.astro'
import Cards from '../../../components/boxes/Cards.astro'
import Documents from '../../../components/boxes/Documents.astro'
import List from '../../../components/boxes/List.astro'
import Statement from '../../../components/boxes/Statement.astro'
import TextWithFiles from '../../../components/boxes/TextWithFiles.astro'
import Layout from '../../../layouts/Layout.astro'
import { getGovernanceFoundation } from '../../../lib/cms/governanceFoundation'
import { formatDate } from '../../../lib/dates'

// Digdir's styringsfundament (SF-01), as administrators fill it in (SF-02):
// the boxes they chose, in their order.
const sf = await getGovernanceFoundation(Astro.request.headers.get('cookie'))
const sections = sf.sections ?? []
const boxes = { statement: Statement, cards: Cards, list: List, textWithFiles: TextWithFiles, documents: Documents }
---

<Layout title="Styringsfundament — ilag" wide>
  <div class="page">
    <header>
      <h1 class="ds-heading" data-size="lg">Styringsfundament</h1>
      <Prose text={sf.intro} />
    </header>
    {
      sections.length === 0 ? (
        <p class="ds-paragraph">Styringsfundamentet er ikke registrert ennå.</p>
      ) : (
        <div class="boxes">
          {sections.map((section, i) => {
            const Box = boxes[section.blockType]
            return (
              <div class:list={['box', { half: section.blockType === 'list' }]}>
                {/* Each component takes the box of its own type. */}
                <Box box={section as never} id={`boks-${i + 1}`} />
              </div>
            )
          })}
        </div>
      )
    }
    <footer>
      {sf.footnote && <p class="ds-paragraph" data-size="sm">{sf.footnote}</p>}
      {sf.updatedAt && <p class="ds-paragraph" data-size="sm">Sist oppdatert {formatDate(sf.updatedAt)}</p>}
    </footer>
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-7);
    max-width: 56rem;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-3);
  }

  /* Every box takes the whole width, except lists, which sit side by side when next to each other. */
  .boxes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ds-size-7) var(--ds-size-4);
  }

  .box {
    grid-column: 1 / -1;
  }

  .box.half {
    grid-column: auto;
  }

  @media (width < 40rem) {
    .box.half {
      grid-column: 1 / -1;
    }
  }

  footer {
    color: var(--ds-color-neutral-text-subtle);
  }
</style>
