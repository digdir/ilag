---
import { cmsFetch } from '@ilag/shared'

import Layout from '../layouts/Layout.astro'

const cmsURL = import.meta.env.PUBLIC_CMS_URL
const { user } = Astro.locals
const userName = [user?.firstName, user?.lastName].filter(Boolean).join(' ') || user?.email

let status: string
try {
  await cmsFetch<{ status: string }>('/health')
  status = 'Connected — the CMS reached its database.'
} catch (err) {
  status = `Not reachable: ${err instanceof Error ? err.message : String(err)}`
}
---

<Layout title="ilag — utviklingsmiljø">
  <h1 class="ds-heading" data-size="xl">ilag</h1>
  {
    user && (
      <form method="post" action="/logg-ut" class="user">
        <p class="ds-paragraph">Logget inn som {userName}</p>
        <button class="ds-button" data-variant="secondary" data-size="sm" type="submit">
          Logg ut
        </button>
      </form>
    )
  }
  <p class="ds-paragraph"><a class="ds-link" href="/team">Teamoversikt</a></p>
  <h2 class="ds-heading" data-size="md">Payload CMS</h2>
  <p class="ds-paragraph">{cmsURL}</p>
  <p class="ds-paragraph">{status}</p>
  <p class="ds-paragraph"><a class="ds-link" href={`${cmsURL}/admin`}>Open the admin panel</a></p>
</Layout>

<style>
  .user {
    display: flex;
    align-items: center;
    gap: var(--ds-size-3);
    margin-block-end: var(--ds-size-6);
  }
</style>
