---
import Tag from '../../../components/Tag.astro'
import Layout from '../../../layouts/Layout.astro'
import { getTool } from '../../../lib/cms/tools'
import { toolTypeLabel } from '../../../lib/tools'

const tool = await getTool(Astro.params.id!, Astro.request.headers.get('cookie'))
if (!tool) Astro.response.status = 404
const resources = tool?.resources ?? []
---

<Layout title={tool ? `${tool.name} — ilag` : 'Fant ikke verktøyet — ilag'} wide current={tool?.name}>
  <div class="page">
    {
      tool ? (
        <>
          <header>
            <Tag>{toolTypeLabel(tool.toolType)}</Tag>
            <h1 class="ds-heading" data-size="lg">
              {tool.name}
            </h1>
            <p class="ds-paragraph description">{tool.description}</p>
            {/* A plain link, like the resources: it leaves ilag (VK-08). */}
            {tool.toolUrl && (
              <p class="ds-paragraph">
                <a class="ds-link" href={tool.toolUrl}>
                  Åpne verktøyet
                </a>
              </p>
            )}
          </header>
          <section>
            <h2 class="ds-heading" data-size="xs">
              Passer for
            </h2>
            {tool.teamTypes.length ? (
              <ul class="team-types">
                {tool.teamTypes.map((type) => (
                  <li>
                    <Tag color="neutral">{type.name}</Tag>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="ds-paragraph">Alle teamtyper</p>
            )}
          </section>
          <section>
            <h2 class="ds-heading" data-size="xs">
              Ressurser
            </h2>
            {resources.length ? (
              <ul class="resources">
                {resources.map((resource) => (
                  <li>
                    <a class="ds-link" href={resource.url}>
                      {resource.label}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="ds-paragraph">Ingen ressurser er lenket opp ennå.</p>
            )}
          </section>
        </>
      ) : (
        <>
          <h1 class="ds-heading" data-size="lg">Fant ikke verktøyet</h1>
          <p class="ds-paragraph">Verktøyet finnes ikke, eller du har ikke tilgang til det.</p>
        </>
      )
    }
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-7);
    max-width: 52rem;
  }

  header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ds-size-3);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  .description {
    text-wrap: pretty;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team-types {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-size-2);
  }

  .resources {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }
</style>
