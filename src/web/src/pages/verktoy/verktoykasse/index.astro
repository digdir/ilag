---
import ListFilter from '../../../components/ListFilter.astro'
import ToolCard from '../../../components/verktoy/ToolCard.astro'
import Layout from '../../../layouts/Layout.astro'
import { getTeamTypes } from '../../../lib/cms/teamTypes'
import { getTools } from '../../../lib/cms/tools'
import { TOOL_TYPE_LABELS } from '../../../lib/tools'
import type { ToolWithTypes } from '../../../types/tool'

const cookie = Astro.request.headers.get('cookie')
const [tools, types] = await Promise.all([getTools(cookie), getTeamTypes(cookie)])

// Search by name and description, and filter by tool type (VK-04) and team
// type (VK-05). A tool with no team types suits all of them, so it matches
// every team type chip.
const chips = [
  {
    key: 'kind',
    legend: 'Verktøytype',
    options: Object.entries(TOOL_TYPE_LABELS).map(([value, label]) => ({ value, label })),
  },
  {
    key: 'type',
    legend: 'Teamtype',
    options: types.map((type) => ({ value: String(type.id), label: type.name })),
  },
]
const teamTypeValues = (tool: ToolWithTypes) =>
  (tool.teamTypes.length ? tool.teamTypes : types).map((type) => type.id).join(' ')
---

<Layout title="Verktøykasse — ilag" wide>
  <div class="page">
    <header>
      <h1 class="ds-heading" data-size="lg">Verktøykasse</h1>
      <p class="ds-paragraph">
        Anbefalte metoder, maler og verktøy. Noe må du forholde deg til, men i det store handler det
        om å velge verktøyet som passer formålet.
      </p>
    </header>
    {
      tools.length ? (
        <>
          <ListFilter
            list="verktoy"
            empty="verktoy-tom"
            label="Søk i verktøykassen"
            placeholder="Søk etter navn eller beskrivelse"
            count={tools.length}
            noun={{ one: 'verktøy', other: 'verktøy' }}
            chips={chips}
          />
          <ul class="tools" id="verktoy">
            {tools.map((tool) => (
              <li
                data-search={`${tool.name} ${tool.description}`.toLowerCase()}
                data-filter-kind={tool.toolType}
                data-filter-type={teamTypeValues(tool)}
              >
                <ToolCard tool={tool} />
              </li>
            ))}
          </ul>
          <p class="ds-paragraph empty" id="verktoy-tom" hidden>
            Ingen verktøy passer filtrene. Prøv en annen kombinasjon.
          </p>
        </>
      ) : (
        <p class="ds-paragraph">Ingen verktøy er registrert ennå.</p>
      )
    }
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-6);
  }

  header {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-3);
    max-width: 45rem;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: var(--ds-size-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tools > li {
    display: grid;
  }

  .tools > li[hidden] {
    display: none;
  }

  .empty {
    padding: var(--ds-size-8);
    border: var(--ds-border-width-default) dashed var(--ds-color-border-subtle);
    border-radius: var(--ds-border-radius-md);
    text-align: center;
  }

  .empty[hidden] {
    display: none;
  }
</style>
