---
import '../styles/global.css'

import Breadcrumbs from '../components/Breadcrumbs.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { breadcrumbs, type Crumb } from '../lib/navigation'

interface Props {
  title: string
  /** Room for a grid of cards; text pages keep the narrow column. */
  wide?: boolean
  /**
   * The name of what the page shows, the last of the breadcrumbs. Pages below
   * a menu page get breadcrumbs from it without this; leave it out when the
   * thing was not found.
   */
  current?: string | null
  /** Pages between the menu page and this one, such as the units above a unit. */
  trail?: Crumb[]
}

const { title, wide = false, current, trail } = Astro.props
const crumbs = breadcrumbs(Astro.url.pathname, { trail, current })
---

<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <title>{title}</title>
    {/* Inter, the default theme's font, from Altinn's CDN as Designsystemet recommends. */}
    <link
      rel="stylesheet"
      href="https://altinncdn.no/fonts/inter/v4.1/inter.css"
      integrity="sha384-OcHzc/By/OPw9uJREawUCjP2inbOGKtKb4A/I2iXxmknUfog2H8Adx71tWVZRscD"
      crossorigin="anonymous"
    />
  </head>
  <body data-color-scheme="auto" data-size="md">
    <a class="ds-skip-link" href="#hovedinnhold">Hopp til hovedinnhold</a>
    <SiteHeader user={Astro.locals.user} pathname={Astro.url.pathname} />
    <main id="hovedinnhold" tabindex="-1" class:list={{ wide }}>
      {crumbs && <Breadcrumbs items={crumbs} />}
      <slot />
    </main>
    <script>
      // Behaviour for Designsystemet's components, such as ds-field.
      import '@digdir/designsystemet-web'
    </script>
  </body>
</html>

<style>
  /* As far from the page as the pages space their own parts. */
  main > :global(.ds-breadcrumbs) {
    margin-block-end: var(--ds-size-8);
  }
</style>
